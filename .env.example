# ChunkFlow configuration. Copy this file to `.env` and edit as needed:
#
#   cp .env.example .env
#
# The host CLI reads `.env` (python-dotenv). Docker Compose also reads `.env`
# for ${VAR} substitution in docker-compose.yml, so any value set here is
# passed to the `ragmcp` container unchanged.
#
# EMBEDDING_BASE_URL — the one variable that differs between host and container:
#   - leave it COMMENTED for a local Ollama: the CLI defaults to
#     http://localhost:11434, the container to http://host.docker.internal:11434
#   - set it to any OTHER url (remote embeddings API, your machine's LAN IP...):
#     both the CLI and the container use it
#   - do NOT set it to http://localhost:11434: inside the container localhost
#     is the container itself and Ollama would be unreachable
#EMBEDDING_BASE_URL='https://your-remote-embeddings-endpoint.example.com'

# EMBEDDING_API_KEY — API key for the /v1/embeddings endpoint (OpenAI protocol).
#   - remote providers (OpenAI, Groq, OpenRouter...): their real key
#   - local Ollama: any value works ('ollama'), the server ignores it
EMBEDDING_API_KEY='ollama'
EMBEDDING_MODEL='embeddinggemma-2:440m'
EMBEDDING_DIM=768

#COLLECTION_NAME='docs_rag'
#QDRANT_URL='http://localhost:6333'  # host CLI only; compose forces http://qdrant:6333 inside the container
